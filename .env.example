# Turso (LibSQL) Configuration
# For local dev without Turso, you can leave these blank or use file:local.db
TURSO_DATABASE_URL="libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Backblaze B2 Storage Configuration
# For local testing before setting up B2, the app will automatically use local upload fallback
B2_KEY_ID="your_b2_key_id"
B2_APPLICATION_KEY="your_b2_application_key"
B2_BUCKET_NAME="your_bucket_name"
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"

# Master Passcode / App Password
APP_PASSWORD="your_secure_passcode"

